---
interface Project {
  title: string;
  technologies: string[];
  link: string;
  preview?: string;
}

const projects: Project[] = [
  {
    title: "KineStat",
    technologies: ["ASP.NET Core", "Entity Framework", "PostgreSQL", "Docker"],
    link: "https://github.com/Abyssalt/kinestat",
    preview: "https://hers.be/les-sections-kinesitherapie-et-informatique-au-service-du-diagnostic-clinique/",
  },
  {
    title: "DualDesk",
    technologies: ["Spring Web MVC", "Java", "Oracle SQL", "Tailwind CSS"],
    link: "https://github.com/BogMarDev/DualDesk",
  },
  {
    title: "BookBox",
    technologies: ["Kotlin", "MVVM", "Room", "Android Studio"],
    link: "https://github.com/BogMarDev/BookBox",
  },
  {
    title: "Projet Docker",
    technologies: ["Docker", "Flask", "Python", "HAProxy", "PostgreSQL"],
    link: "https://github.com/BogMarDev/DockerProject",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec" data-i18n="projects.sectionTitle">Mon travail</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8" data-i18n="projects.title">Projets</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project, index) => (
          <div class="group flex flex-col justify-between p-6 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:border-[var(--sec)] transition-colors duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <h4 class="text-2xl font-semibold">{project.title}</h4>
                <span class="py-1 px-3 text-xs rounded-full bg-[var(--white-icon-tr)] text-[var(--white-icon)]" data-i18n-project-status={index}>
                  {index === 0 ? "Contributeur" : index === 2 ? "Solo" : "Groupe"}
                </span>
              </div>

              <p class="text-[var(--white-icon)] text-sm md:text-base mb-6 leading-relaxed" data-i18n-project-desc={index}>
                {index === 0 && "Application web pour kinésithérapeutes dédiée à la réalisation de bilans cliniques et à la détection de signaux d'alerte (Red Flags)."}
                {index === 1 && "Application moderne et ergonomique permettant aux étudiants et professeurs de suivre les statistiques de réussite académique (Projet Intégré HERS)."}
                {index === 2 && "Application mobile Android de suivi des lectures en milieu familial séparant interface parent et enfant via une architecture MVVM."}
                {index === 3 && "Mise en place d'une architecture microservices complète avec authentification, équilibrage de charge HAProxy et serveur NGINX."}
              </p>

              <div class="flex flex-wrap gap-2 mb-6">
                {project.technologies.map((tech) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-[#1f1f1f] text-[var(--sec)] border border-[var(--white-icon-tr)]">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-end gap-6 pt-4 border-t border-[var(--white-icon-tr)]">
              <a
                target="_blank"
                href={project.link}
                class="inline-flex items-center gap-2 text-sm font-medium text-white hover:text-[var(--sec)] transition-colors duration-300 group/link"
              >
                <span data-i18n="projects.sourceCode">Code source</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 transform transition-transform duration-300 group-hover/link:translate-x-1 group-hover/link:-translate-y-1">
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
              </a>

              {index === 0 && project.preview && (
                <a
                  target="_blank"
                  href={project.preview}
                  class="inline-flex items-center gap-2 text-sm font-medium text-white hover:text-[var(--sec)] transition-colors duration-300 group/link"
                >
                  <span data-i18n="projects.article">Lire l'article</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 transform transition-transform duration-300 group-hover/link:translate-x-1 group-hover/link:-translate-y-1">
                    <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://github.com/BogMarDev"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md" data-i18n="projects.moreOnGithub">Plus de projets sur</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
        <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
      </svg>
    </a>
  </div>
</section>