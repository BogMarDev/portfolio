---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Marco Bogatu - Développeur Analyste créant des expériences numériques et des applications robustes."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <link rel="canonical" href="https://bogmardev.github.io/portfolio/" />

    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}/fonts/montserrat-latin-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Marco Bogatu | Développeur Analyste"
    />
    <meta
      property="og:description"
      content="Portfolio de Marco Bogatu, Développeur Analyste spécialisé dans la conception d'applications et de solutions logicielles."
    />
    <meta
      property="og:image"
      content="https://bogmardev.github.io/portfolio/og.image.png"
    />
    <meta property="og:url" content="https://bogmardev.github.io/portfolio" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Portfolio de Marco Bogatu"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Marco Bogatu",
        "alternateName": "Marco Bogatu",
        "url": "https://bogmardev.github.io/portfolio",
        "image": "https://bogmardev.github.io/portfolio/og.image.png",
        "sameAs": [
          "https://github.com/BogMarDev",
          "https://www.linkedin.com/in/marcobogatudev/"
        ],
        "jobTitle": "Développeur Analyste",
        "description": "Développeur Analyste concevant des solutions logicielles robustes et performantes."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>